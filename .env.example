# ==============================================================================
# Coralink Web - Modelo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha conforme seu ambiente
# ==============================================================================

# URL da Coralink-API (Backend)
NEXT_PUBLIC_API_URL=https://coralink-api.onrender.com

# Nome da Aplicação
NEXT_PUBLIC_APP_NAME=Coralink

# Google OAuth2 Client ID (Para login social com Google Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id-google.apps.googleusercontent.com

# E-mail de Suporte / Contato exibido na aplicação
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@coralink.com
